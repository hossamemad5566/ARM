/* USER CODE BEGIN Header_Motor_T */
/**
* @brief Function implementing the Motor thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_Motor_T */
void Motor_T(void *argument)
{
  /* USER CODE BEGIN Motor_T */
  /* Infinite loop */
  for(;;)
  {
    Motor_Set_Speed(70);
    Motor_Move_L();
    osDelay(1000);
    Motor_Stop();
    osDelay(1000);
    Motor_Set_Speed(100);
    Motor_Move_R();
    osDelay(1000);
    Motor_Stop();
    osDelay(1000);
  }
  /* USER CODE END Motor_T */
}

