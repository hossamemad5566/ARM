/* USER CODE BEGIN Header_UART_T */
/**
  * @brief  Function implementing the UART thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_UART_T */
void UART_T(void *argument)
{
  /* USER CODE BEGIN UART_T */
  /* Infinite loop */
  for(;;)
  {
    osDelay(1);
  }
  /* USER CODE END UART_T */
}

